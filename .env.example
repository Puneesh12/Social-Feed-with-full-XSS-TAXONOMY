# =============================================================================
# Chirp — Social Feed with a Full XSS Taxonomy
# Copy this file to `.env` and adjust as needed. `docker-compose` reads `.env`.
# =============================================================================

# ----- Build mode -----------------------------------------------------------
# The single switch that selects the vulnerable or the defended behaviour from
# ONE shared code base (report §6.4). Valid values: vulnerable | defended
BUILD_MODE=vulnerable

# The frontend reads this at build time (Vite). Keep it in sync with BUILD_MODE.
VITE_BUILD_MODE=vulnerable

# ----- Ports ----------------------------------------------------------------
WEB_PORT=8080          # Nginx edge -> the app
API_PORT=3000          # Express API (internal; proxied by Nginx)
COLLECTOR_PORT=9000    # Attacker collector (lab-only, 127.0.0.1)

# ----- MongoDB --------------------------------------------------------------
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=chirp

# ----- Secrets --------------------------------------------------------------
# In a real deployment these come from a secret manager, never the repo.
SESSION_SECRET=dev-only-session-secret-change-me
CSRF_SECRET=dev-only-csrf-secret-change-me

# ----- Lab collector --------------------------------------------------------
# Where injected beacons phone home in the lab. Points at the collector service.
COLLECTOR_URL=http://127.0.0.1:9000/collect
